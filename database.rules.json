{
  "rules": {
    ".read": false,
    ".write": false,
    "socialChat": {
      ".read": true,
      ".indexOn": ["ts"],
      "$msgId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['user_id','nickname','text','ts']) && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('nickname').isString() && newData.child('nickname').val().length <= 30 && newData.child('ts').isNumber()"
      }
    },
    "socialChatRooms": {
      "$roomId": {
        ".read": true,
        ".indexOn": ["ts"],
        "$msgId": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['user_id','nickname','ts']) && newData.child('nickname').isString() && newData.child('nickname').val().length <= 30 && newData.child('ts').isNumber()"
        }
      }
    },
    "signals": {
      ".indexOn": ["ts"],
      "$roomId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["ts"],
        "$signalId": {
          ".validate": "newData.child('ts').isNumber()"
        }
      }
    },
    "messages": {
      "$roomId": {
        ".read": true,
        ".write": true,
        ".indexOn": ["ts"],
        "$msgId": {
          ".validate": "newData.hasChildren(['user_id','ts']) && newData.child('ts').isNumber()"
        }
      }
    },
    "profiles": {
      "$nickname": {
        ".read": true,
        ".write": true,
        ".validate": "$nickname.length <= 30"
      }
    },
    "rooms": {
      ".read": true,
      "$roomId": {
        ".write": true,
        ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 50"
      }
    },
    "fcm_tokens": {
      ".read": true,
      "$userId": {
        ".write": true,
        ".validate": "newData.hasChildren(['token','user_id','ts']) && newData.child('token').isString() && newData.child('token').val().length > 10 && newData.child('user_id').isString() && newData.child('ts').isNumber()"
      }
    },
    "fcm_active_room": {
      ".read": true,
      "$userId": {
        ".write": true,
        ".validate": "newData.hasChildren(['room_id','ts']) && newData.child('room_id').isString() && newData.child('ts').isNumber()"
      }
    },
    "moaru": {
      "v3": {
        ".read": "auth != null",
        ".write": "auth != null",
        "messages": {
          "$roomId": {
            ".indexOn": ["ts"]
          }
        }
      }
    }
  }
}
